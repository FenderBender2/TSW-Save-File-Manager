<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SVNRevision>$Id: TSW Save File Manager.vbproj 1516 2026-11-11 15:56:26Z Pete $</SVNRevision>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TSW_Save_Game_Manager</RootNamespace>
    <StartupObject>TSW_Save_Game_Manager.My.MyApplication</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <ApplicationIcon>Assets\TSWSaveManager2.ico</ApplicationIcon>
    <Version>1.2.2</Version>
    <FileVersion>1.2.2.0</FileVersion>
    <InformationalVersion>1.2.2</InformationalVersion>
    <Authors>P. Lewis</Authors>
    <Copyright>© P. Lewis 2026</Copyright>
    <Company>TSWSaveFileManager</Company>
    <Product>TSW Save File Manager</Product>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants></DefineConstants>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants></DefineConstants>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="TSWSaveFileManager.vb_old" />
	  <None Remove="TSWSFM.vb_old" />
	</ItemGroup>

	<ItemGroup>
    <Content Include="Assets\TSWSaveManager2.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\TSWSaveManager2.ico" />
    <EmbeddedResource Include="Assets\ArrowUp.png" />
    <EmbeddedResource Include="Assets\ArrowDown.png" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Update="My Project\Settings.Designer.vb">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Update="My Project\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
